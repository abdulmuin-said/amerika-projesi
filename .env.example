# ── PostgreSQL Database Settings ──
POSTGRES_DB=novacanvas_db
POSTGRES_USER=novacanvas
POSTGRES_PASSWORD=novacanvas_secure_pass_2025
POSTGRES_PORT=5432

# ── Spring Boot Backend Settings ──
BACKEND_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# ── Stripe Payment Gateway Settings ──
# For live Stripe test mode, obtain your API keys from https://dashboard.stripe.com/test/apikeys
# If left blank, the platform automatically runs in graceful Sandbox Demo Mode with test cards.
STRIPE_API_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Spring Mail / SMTP) Settings ──
# Option 1: Gmail (Free, generate App Password from Google Account Security -> 2-Step Verification)
# Option 2: Resend, SendGrid, Amazon SES, or Mailpit
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password
SPRING_MAIL_FROM="NovaCanvas Studios <concierge@novacanvas.com>"

# ── Next.js 15 Frontend Settings ──
FRONTEND_PORT=3000
SERVER_URL=http://backend:8080
